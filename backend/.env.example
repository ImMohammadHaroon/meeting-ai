# Backend Environment Variables
# Copy this to .env and fill in your values

PORT=5000
NODE_ENV=development

# Supabase Configuration (both required on Render)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Frontend URL (for CORS + invite email links)
FRONTEND_URL=http://localhost:5173

# Email — option A: Gmail (use App Password, not regular password)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
# Optional overrides (587 recommended on Render; 465 is often blocked)
# GMAIL_SMTP_PORT=587
# GMAIL_SMTP_SECURE=false

# Email — option B: transactional SMTP (SendGrid, Resend, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
# SMTP_FROM=noreply@meetingai.dev
